# --- База данных -------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_NAME=
POSTGRES_HOST=
POSTGRES_PORT=

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
# Домены через запятую
ALLOWED_HOSTS=

# --- Telegram ----------------------------------------------------------------
# Токен и свой id читают оба контейнера: бэкенду токен нужен, чтобы сверять подпись
# Telegram у входов, а id — чтобы не писать в журнал свои же заходы.
BOT_TOKEN=
ADMIN_TELEGRAM_ID=
WEBAPP_URL=

# --- Бот пишет в колоду ------------------------------------------------------
# Общий секрет бэкенда и бота: им подписаны служебные ручки. Длинная строка из
# латиницы и цифр — кириллицу в заголовок не положить.
BOT_API_TOKEN=
# Адрес бэкенда для бота. Внутри докера — имя сервиса; на своей машине 127.0.0.1:8000.
BACKEND_URL=http://backend:8000
# Ключ fal.ai — им бот рисует картинки к карточкам через FLUX.1 [schnell].
FAL_KEY=

# --- Расписание повторений ---------------------------------------------------
# Лестница сроков в днях, разброс к сроку в процентах и уровень, на который уезжает
# слово, узнанное с первого взгляда. Пустые значения — берутся эти же.
LADDER=1,3,7,16,35
JITTER_PERCENT=10
FIRST_SIGHT_LEVEL=3
# Потолок сеанса у кнопки «Повторить» и сколько новых карточек в него попадает.
SESSION_LIMIT=20
NEW_LIMIT=10
# Пока false — новая логика видна только тем, кому поставили галочку в админке.
SCHEDULING_FOR_ALL=false

# --- Слово в группу ----------------------------------------------------------
# Id группы, куда бот дважды в день присылает случайное слово из колоды. У супергруппы
# он отрицательный, вида -1001234567890. Пусто — не присылать вовсе.
GROUP_CHAT_ID=

# --- Развёртывание -----------------------------------------------------------
DOMAIN=
