# Шаблон. Скопировать в .env и заполнить: cp .env.example .env
# Блок «База данных» и DJANGO_SECRET_KEY обязательны: без них приложение не
# стартует и назовёт незаполненное поле. Остальное можно оставить пустым.

# --- База данных -------------------------------------------------------------
# Единственный источник правды и для docker-compose, и для Django: settings.py
# собирает DATABASES из этих переменных, поэтому логин, пароль и имя базы нигде
# не дублируются.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_NAME=
POSTGRES_HOST=
# Порт на хосте. Держим не 5432, чтобы не конфликтовать с локальным Postgres.
POSTGRES_PORT=

# --- Django ------------------------------------------------------------------
# Обязателен, когда DJANGO_DEBUG=false. Сгенерировать:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=

# --- Telegram ----------------------------------------------------------------
# Заполняется на этапе бота: /start печатает твой Telegram ID
BOT_TOKEN=
ADMIN_TELEGRAM_ID=
# HTTPS-адрес Mini App (в разработке — туннель cloudflared)
WEBAPP_URL=
