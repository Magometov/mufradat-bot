# Адрес берётся из переменной DOMAIN. Домен — сертификат выпускается сам; для проверки
# на своей машине ставится «:80», и тогда Caddy работает без https.
#
# Порядок блоков здесь — порядок разбора: `handle` взаимоисключающие, запрос забирает
# первый совпавший. Поэтому частные правила стоят выше общих.
{$DOMAIN} {
    encode zstd gzip

    # --- Заглушка на время работ ---------------------------------------------------
    #
    # Признак — файл `flags/maintenance` в каталоге проекта. Caddy проверяет его на
    # каждом запросе, поэтому включение и снятие мгновенные: `touch` и `rm`, без
    # пересоздания контейнеров. Переменная окружения так не умеет — её читают один раз
    # при запуске.
    #
    # Закрывается приложение и API, но не админка: ею правится как раз то, из-за чего
    # работы. Заглушка стоит в Caddy, а не в Django, потому что Django в это время
    # пересобирается и мигрирует, а Caddy остаётся на ногах.

    # API отвечает кодом, а не страницей: приложение, открытое до начала работ, должно
    # понять, что сервер закрыт, а не разбирать HTML как колоду.
    @closed_api {
        file {
            root /flags
            try_files maintenance
        }
        path /api/*
    }
    handle @closed_api {
        respond "Технические работы" 503
    }

    # Админка и её статика остаются открытыми, картинки — заодно: страница работ
    # обходится без них, но и закрывать их незачем.
    @closed {
        file {
            root /flags
            try_files maintenance
        }
        not path /admin/* /s/* /m/*
    }
    handle @closed {
        root * /srv
        rewrite * /maintenance.html
        file_server
    }

    # --- Обычная работа ------------------------------------------------------------

    # Заголовки безопасности на все ответы. `unsafe-inline` для скриптов приходится
    # оставить: оформление ставится встроенным скриптом до первой отрисовки, а его хэш
    # молча ломался бы при каждой правке. Главное всё равно закрыто — чужие домены для
    # скриптов и запросов, отправка форм и встраивание в чужие страницы.
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        -Server
    }

    # Служебные ручки бота. Стоят выше общего правила для API, иначе оно заберёт их
    # себе. Бот ходит к Django внутри сети докера, поэтому запрет снаружи ему ничего
    # не стоит, а токен остаётся вторым слоем, а не единственным.
    @internal path /api/v1/internal/*
    handle @internal {
        respond 404
    }

    # API и админка — в Django. Caddy сам добавляет X-Forwarded-Proto, поэтому Django
    # собирает адрес картинок с правильной схемой.
    @django path /api/* /admin/*
    handle @django {
        reverse_proxy backend:8000
    }

    # Картинки — файлами, минуя Django.
    handle_path /m/* {
        header Cache-Control "public, max-age=3600"
        root * /var/www/media
        file_server
    }

    # Статика Django: её собирает collectstatic в том `static`, и нужна она только
    # админке. Хэша в именах нет, поэтому кэш короткий.
    handle_path /s/* {
        header Cache-Control "public, max-age=3600"
        root * /var/www/static
        file_server
    }

    # Сборка приложения. Vite кладёт хэш содержимого в имя файла, поэтому такой адрес
    # не меняет содержимого никогда — его можно кэшировать навсегда.
    @assets path /assets/*
    handle @assets {
        header Cache-Control "public, max-age=31536000, immutable"
        root * /srv
        file_server
    }

    # Всё остальное — собранное приложение. Кэшировать index.html нельзя: в нём лежат
    # имена файлов сборки, и после выкладки браузер ещё сутки просил бы старые.
    # try_files нужен, чтобы прямой заход по любому пути отдавал index.html, а не 404.
    handle {
        header Cache-Control "no-cache"
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
