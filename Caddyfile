# Адрес берётся из переменной DOMAIN. Домен — сертификат выпускается сам; для проверки
# на своей машине ставится «:80», и тогда Caddy работает без https.
{$DOMAIN} {
	encode zstd gzip

	# --- Заглушка на время работ ---------------------------------------------------
	#
	# Закрывает приложение и API, но не админку: ею правится как раз то, из-за чего
	# работы и начаты. Стоит в Caddy, а не в Django, потому что Django в это время
	# пересобирается и мигрирует, а Caddy остаётся на ногах.
	#
	# Значение подставляется в кавычках при чтении конфига: пустое или незнакомое даёт
	# «не равно true», то есть обычную работу. Подстановка в имя сниппета этого не
	# умеет — там пустая переменная валит весь конфиг, и сайт не поднимается вообще.
	# Включается целями `make maintenance-on` и `make maintenance-off`.

	# API отвечает кодом, а не страницей: приложение, открытое до начала работ, должно
	# понять, что сервер закрыт, а не разбирать HTML как колоду.
	@closed_api {
		expression `"{$MAINTENANCE}" == "true"`
		path /api/*
	}
	handle @closed_api {
		respond "Технические работы" 503
	}

	@closed {
		expression `"{$MAINTENANCE}" == "true"`
		not path /admin/* /s/* /m/*
	}
	handle @closed {
		root * /srv
		rewrite * /maintenance.html
		file_server
	}

	# --- Обычная работа ------------------------------------------------------------

	# Картинки карточек и статика админки уходят файлами, минуя Django.
	handle_path /m/* {
		root * /var/www/media
		file_server
	}

	handle_path /s/* {
		root * /var/www/static
		file_server
	}

	# API и админка — в Django. Caddy сам добавляет X-Forwarded-Proto, поэтому Django
	# собирает адреса картинок с правильной схемой.
	@django path /api/* /admin/*
	handle @django {
		reverse_proxy backend:8000
	}

	# Всё остальное — собранное приложение. try_files нужен, чтобы прямой заход по
	# любому пути отдавал index.html, а не 404.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
